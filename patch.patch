diff --git a/backend_src/controllers/checkinController.js b/backend_src/controllers/checkinController.js
new file mode 100644
index 0000000..be60897
--- /dev/null
+++ b/backend_src/controllers/checkinController.js
@@ -0,0 +1,73 @@
+const { PrismaClient } = require('@prisma/client');
+const prisma = new PrismaClient();
+const { HttpError, handleError } = require('../utils/httpError');
+
+// POST /api/checkin/verify  { qrCodeHash }
+// Доступ: ORGANIZER (только свои события), EVENT_ADMIN, PLATFORM_ADMIN
+exports.verifyTicket = async (req, res) => {
+  try {
+    const { qrCodeHash } = req.body || {};
+    if (typeof qrCodeHash !== 'string' || !/^[a-f0-9]{64}$/.test(qrCodeHash)) {
+      throw new HttpError(400, 'qrCodeHash must be a 64-char hex string');
+    }
+
+    const ticket = await prisma.ticket.findUnique({
+      where: { qrCodeHash },
+      include: {
+        ticketType: { select: { name: true } },
+        order: { select: { status: true, event: { select: { id: true, title: true, organizerId: true } } } },
+      },
+    });
+    if (!ticket) throw new HttpError(404, 'Ticket not found: invalid QR code');
+
+    const event = ticket.order.event;
+
+    // Организатор может сканировать только билеты своих событий
+    if (req.user.role === 'ORGANIZER' && event.organizerId !== req.user.id) {
+      throw new HttpError(403, 'You can only check in tickets for your own events');
+    }
+    if (ticket.order.status !== 'COMPLETED' || ['CANCELLED', 'REFUNDED'].includes(ticket.status)) {
+      throw new HttpError(403, `Ticket is not valid (${ticket.status})`);
+    }
+
+    if (ticket.status === 'CHECKED_IN') {
+      return respondAlreadyUsed(res, ticket);
+    }
+
+    // Double-spend protection: атомарный переход VALID -> CHECKED_IN.
+    // Если два сканера одновременно проверят один билет, count=1 получит только один.
+    const result = await prisma.$transaction(async (tx) => {
+      const updated = await tx.ticket.updateMany({
+        where: { id: ticket.id, status: 'VALID' },
+        data: { status: 'CHECKED_IN' },
+      });
+      if (updated.count === 0) return null;
+      return tx.checkIn.create({ data: { ticketId: ticket.id, scannedBy: req.user.id } });
+    });
+
+    if (!result) return respondAlreadyUsed(res, ticket);
+
+    return res.json({
+      valid: true,
+      message: 'Check-in successful',
+      checkedInAt: result.scannedAt,
+      ticket: { id: ticket.id, attendeeName: ticket.attendeeName, ticketType: ticket.ticketType.name },
+      event: { id: event.id, title: event.title },
+    });
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
+
+async function respondAlreadyUsed(res, ticket) {
+  const first = await prisma.checkIn.findFirst({
+    where: { ticketId: ticket.id },
+    orderBy: { scannedAt: 'asc' },
+  });
+  return res.status(409).json({
+    valid: false,
+    error: 'Ticket already checked in',
+    checkedInAt: first ? first.scannedAt : null,
+    ticket: { id: ticket.id, attendeeName: ticket.attendeeName },
+  });
+}
diff --git a/backend_src/controllers/orderController.js b/backend_src/controllers/orderController.js
new file mode 100644
index 0000000..45bef8b
--- /dev/null
+++ b/backend_src/controllers/orderController.js
@@ -0,0 +1,154 @@
+const { PrismaClient, Prisma } = require('@prisma/client');
+const prisma = new PrismaClient();
+const { HttpError, handleError } = require('../utils/httpError');
+const { generateQrHash } = require('../utils/qr');
+
+const MAX_TICKETS_PER_ORDER = 10;
+
+// Валидация и нормализация body: { eventId, items: [{ ticketTypeId, quantity, attendeeNames? }] }
+function parseOrderBody(body) {
+  const { eventId, items } = body || {};
+
+  if (!Number.isInteger(eventId)) {
+    throw new HttpError(400, 'eventId must be an integer');
+  }
+  if (!Array.isArray(items) || items.length === 0) {
+    throw new HttpError(400, 'items must be a non-empty array');
+  }
+
+  const merged = new Map(); // ticketTypeId -> { quantity, attendeeNames }
+  let totalQty = 0;
+
+  for (const item of items) {
+    const { ticketTypeId, quantity, attendeeNames } = item || {};
+    if (!Number.isInteger(ticketTypeId) || !Number.isInteger(quantity) || quantity < 1) {
+      throw new HttpError(400, 'Each item needs integer ticketTypeId and quantity >= 1');
+    }
+    if (attendeeNames !== undefined) {
+      if (!Array.isArray(attendeeNames) || attendeeNames.length !== quantity ||
+          attendeeNames.some((n) => typeof n !== 'string' || !n.trim())) {
+        throw new HttpError(400, 'attendeeNames must be an array of non-empty strings, one per ticket');
+      }
+    }
+    totalQty += quantity;
+    const prev = merged.get(ticketTypeId);
+    if (prev) {
+      prev.quantity += quantity;
+      prev.attendeeNames = undefined; // при слиянии дублей имена сбрасываем
+    } else {
+      merged.set(ticketTypeId, { quantity, attendeeNames });
+    }
+  }
+
+  if (totalQty > MAX_TICKETS_PER_ORDER) {
+    throw new HttpError(400, `Maximum ${MAX_TICKETS_PER_ORDER} tickets per order`);
+  }
+
+  return { eventId, items: [...merged.entries()].map(([ticketTypeId, v]) => ({ ticketTypeId, ...v })) };
+}
+
+// POST /api/orders
+exports.createOrder = async (req, res) => {
+  try {
+    const { eventId, items } = parseOrderBody(req.body);
+
+    const user = await prisma.user.findUnique({ where: { id: req.user.id } });
+    if (!user) throw new HttpError(401, 'User no longer exists');
+
+    const order = await prisma.$transaction(async (tx) => {
+      const event = await tx.event.findUnique({
+        where: { id: eventId },
+        include: { ticketTypes: true },
+      });
+      if (!event || !event.isPublished) throw new HttpError(404, 'Event not found');
+      if (event.endTime < new Date()) throw new HttpError(400, 'Event has already ended');
+
+      let total = new Prisma.Decimal(0);
+      const toIssue = []; // { ticketTypeId, attendeeName }
+
+      for (const item of items) {
+        const tt = event.ticketTypes.find((t) => t.id === item.ticketTypeId);
+        if (!tt) throw new HttpError(400, `Ticket type ${item.ticketTypeId} does not belong to this event`);
+
+        const isPaid = tt.isPaid || tt.price.gt(0);
+        if (isPaid && !event.paidSalesActive) {
+          throw new HttpError(403, 'Paid ticket sales are not active for this event');
+        }
+
+        // Атомарное списание остатков: защита от overselling при параллельных заказах
+        const updated = await tx.ticketType.updateMany({
+          where: { id: tt.id, remainingQuantity: { gte: item.quantity } },
+          data: { remainingQuantity: { decrement: item.quantity } },
+        });
+        if (updated.count === 0) throw new HttpError(409, `Not enough tickets left for "${tt.name}"`);
+
+        total = total.plus(tt.price.mul(item.quantity));
+        for (let i = 0; i < item.quantity; i++) {
+          toIssue.push({
+            ticketTypeId: tt.id,
+            attendeeName: item.attendeeNames ? item.attendeeNames[i].trim() : user.fullName,
+          });
+        }
+      }
+
+      // TODO: интеграция с платёжным шлюзом. Пока заказ сразу COMPLETED.
+      const created = await tx.order.create({
+        data: { userId: user.id, eventId, totalAmount: total, status: 'COMPLETED' },
+      });
+
+      for (const t of toIssue) {
+        await tx.ticket.create({
+          data: {
+            orderId: created.id,
+            ticketTypeId: t.ticketTypeId,
+            attendeeName: t.attendeeName,
+            qrCodeHash: generateQrHash(),
+          },
+        });
+      }
+
+      return tx.order.findUnique({
+        where: { id: created.id },
+        include: { tickets: { include: { ticketType: { select: { name: true, price: true } } } } },
+      });
+    });
+
+    return res.status(201).json({ message: 'Order placed', order });
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
+
+// GET /api/orders — заказы текущего пользователя
+exports.getMyOrders = async (req, res) => {
+  try {
+    const orders = await prisma.order.findMany({
+      where: { userId: req.user.id },
+      orderBy: { createdAt: 'desc' },
+      include: { event: { select: { id: true, title: true, startTime: true } }, tickets: true },
+    });
+    return res.json(orders);
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
+
+// GET /api/orders/:id
+exports.getOrderById = async (req, res) => {
+  try {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id)) throw new HttpError(400, 'Invalid order id');
+
+    const order = await prisma.order.findUnique({
+      where: { id },
+      include: { event: { select: { id: true, title: true, startTime: true } }, tickets: true },
+    });
+    // 404 вместо 403, чтобы не раскрывать существование чужих заказов
+    if (!order || (order.userId !== req.user.id && req.user.role !== 'PLATFORM_ADMIN')) {
+      throw new HttpError(404, 'Order not found');
+    }
+    return res.json(order);
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
diff --git a/backend_src/controllers/ticketController.js b/backend_src/controllers/ticketController.js
new file mode 100644
index 0000000..85fe8f2
--- /dev/null
+++ b/backend_src/controllers/ticketController.js
@@ -0,0 +1,50 @@
+const { PrismaClient } = require('@prisma/client');
+const prisma = new PrismaClient();
+const { HttpError, handleError } = require('../utils/httpError');
+
+const ticketInclude = {
+  ticketType: { select: { name: true, price: true } },
+  order: {
+    select: {
+      id: true,
+      userId: true,
+      event: { select: { id: true, title: true, venueName: true, venueAddress: true, startTime: true, endTime: true } },
+    },
+  },
+};
+
+// GET /api/tickets?status=VALID — билеты текущего пользователя (с qrCodeHash для отрисовки QR)
+exports.getMyTickets = async (req, res) => {
+  try {
+    const where = { order: { userId: req.user.id, status: 'COMPLETED' } };
+    if (req.query.status) {
+      const allowed = ['VALID', 'CHECKED_IN', 'CANCELLED', 'REFUNDED'];
+      if (!allowed.includes(req.query.status)) throw new HttpError(400, 'Invalid status filter');
+      where.status = req.query.status;
+    }
+    const tickets = await prisma.ticket.findMany({
+      where,
+      orderBy: { createdAt: 'desc' },
+      include: ticketInclude,
+    });
+    return res.json(tickets);
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
+
+// GET /api/tickets/:id
+exports.getTicketById = async (req, res) => {
+  try {
+    const id = Number(req.params.id);
+    if (!Number.isInteger(id)) throw new HttpError(400, 'Invalid ticket id');
+
+    const ticket = await prisma.ticket.findUnique({ where: { id }, include: ticketInclude });
+    if (!ticket || (ticket.order.userId !== req.user.id && req.user.role !== 'PLATFORM_ADMIN')) {
+      throw new HttpError(404, 'Ticket not found');
+    }
+    return res.json(ticket);
+  } catch (err) {
+    return handleError(res, err);
+  }
+};
diff --git a/backend_src/middleware/authMiddleware.js b/backend_src/middleware/authMiddleware.js
index e69de29..33f82c2 100644
--- a/backend_src/middleware/authMiddleware.js
+++ b/backend_src/middleware/authMiddleware.js
@@ -0,0 +1,44 @@
+const jwt = require('jsonwebtoken');
+
+const ROLES = Object.freeze({
+  ATTENDEE: 'ATTENDEE',
+  ORGANIZER: 'ORGANIZER',
+  EVENT_ADMIN: 'EVENT_ADMIN',
+  PLATFORM_ADMIN: 'PLATFORM_ADMIN',
+});
+
+// 1) Аутентификация: проверяет JWT из заголовка "Authorization: Bearer <token>"
+//    и кладёт { id, email, role } в req.user
+function authenticate(req, res, next) {
+  const header = req.headers.authorization || '';
+  const [scheme, token] = header.split(' ');
+
+  if (scheme !== 'Bearer' || !token) {
+    return res.status(401).json({ error: 'Authentication required' });
+  }
+
+  try {
+    const payload = jwt.verify(token, process.env.JWT_SECRET || 'supersecretkey');
+    req.user = { id: payload.id, email: payload.email, role: payload.role };
+    return next();
+  } catch (err) {
+    const msg = err.name === 'TokenExpiredError' ? 'Token expired' : 'Invalid token';
+    return res.status(401).json({ error: msg });
+  }
+}
+
+// 2) Авторизация (RBAC): authorize(ROLES.ORGANIZER, ROLES.EVENT_ADMIN)
+//    PLATFORM_ADMIN имеет доступ ко всему.
+function authorize(...allowedRoles) {
+  return (req, res, next) => {
+    if (!req.user) {
+      return res.status(401).json({ error: 'Authentication required' });
+    }
+    if (req.user.role === ROLES.PLATFORM_ADMIN || allowedRoles.includes(req.user.role)) {
+      return next();
+    }
+    return res.status(403).json({ error: 'Forbidden: insufficient permissions' });
+  };
+}
+
+module.exports = { authenticate, authorize, ROLES };
