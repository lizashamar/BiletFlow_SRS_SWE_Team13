diff --git a/backend_src/utils/httpError.js b/backend_src/utils/httpError.js
new file mode 100644
index 0000000..2d0e875
--- /dev/null
+++ b/backend_src/utils/httpError.js
@@ -0,0 +1,17 @@
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+// Единый обработчик ошибок для контроллеров
+function handleError(res, err) {
+  if (err instanceof HttpError) {
+    return res.status(err.status).json({ error: err.message });
+  }
+  console.error(err);
+  return res.status(500).json({ error: 'Internal server error' });
+}
+
+module.exports = { HttpError, handleError };
diff --git a/backend_src/utils/qr.js b/backend_src/utils/qr.js
new file mode 100644
index 0000000..6f39855
--- /dev/null
+++ b/backend_src/utils/qr.js
@@ -0,0 +1,9 @@
+const crypto = require('crypto');
+
+// Криптостойкий уникальный токен для QR-кода билета (64 hex-символа, 256 бит).
+// Именно это значение хранится в tickets.qr_code_hash (UNIQUE) и кодируется в QR.
+function generateQrHash() {
+  return crypto.randomBytes(32).toString('hex');
+}
+
+module.exports = { generateQrHash };
