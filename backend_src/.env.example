# Copy to the project root as ".env" (dotenv loads it from where you run `npm start`).
# Never commit the real .env file.

PORT=5000

# Required in production (server refuses to start without it). Use a long random string,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biletflow_db?schema=public

# Optional
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173     # default is * (any origin)
# PUBLIC_URL=http://localhost:5173      # used for the event URL inside .ics files
